{
  "manifest_version": 3,
  "name": "Task Organizer",
  "version": "1.0.0",
  "description": "Organize your tasks with timers and sound notifications.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Task Organizer"
  },
  "permissions": ["storage"],
  "host_permissions": []
}
